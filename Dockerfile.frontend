FROM node:18-alpine AS builder

WORKDIR /app

# Install dependencies
COPY wheeleye/frontend/package.json wheeleye/frontend/package-lock.json ./
RUN npm install

# Copy source and build
COPY wheeleye/frontend/ ./
RUN npm run build

# Serve with Nginx
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
